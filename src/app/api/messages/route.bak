import { NextRequest, NextResponse } from 'next/server';
import { db } from '@/lib/db';
import { requireAuth } from '@/lib/auth';

// GET /api/messages?type=inbox|sent
// inbox  = الرسائل الموجهة للمستخدم الحالي + رسائل المدير العامة (recipientId=null)
// sent   = الرسائل التي أرسلها المستخدم الحالي
export async function GET(request: NextRequest) {
  try {
    const user = await requireAuth();
    const { searchParams } = new URL(request.url);
    const type = searchParams.get('type') || 'inbox';
    const search = searchParams.get('search') || '';

    const where: any = {};
    if (type === 'sent') {
      where.senderId = user.id;
    } else {
      // inbox: الرسائل الموجهة للمستخدم + الرسائل العامة من المدير
      where.OR = [
        { recipientId: user.id },
        { recipientId: null, senderRole: 'director' },
      ];
    }

    if (search) {
      where.AND = [
        {
          OR: [
            { subject: { contains: search } },
            { content: { contains: search } },
            { senderName: { contains: search } },
            { recipientName: { contains: search } },
          ],
        },
      ];
    }

    const messages = await db.message.findMany({
      where,
      orderBy: { createdAt: 'desc' },
      take: 200,
    });

    // عدد الرسائل غير المقروءة في صندوق الوارد
    const unreadCount = await db.message.count({
      where: {
        isRead: false,
        OR: [
          { recipientId: user.id },
          { recipientId: null, senderRole: 'director' },
        ],
      },
    });

    return NextResponse.json({ messages, unreadCount });
  } catch (error: any) {
    if (error.message === 'UNAUTHORIZED') {
      return NextResponse.json({ error: 'غير مصرح' }, { status: 401 });
    }
    console.error('GET /api/messages error:', error);
    return NextResponse.json({ error: 'حدث خطأ' }, { status: 500 });
  }
}

// POST /api/messages - إرسال رسالة جديدة
// أي مستخدم يمكنه الإرسال لأي مستخدم آخر أو للجميع (للمدير)
export async function POST(request: NextRequest) {
  try {
    const user = await requireAuth();
    const body = await request.json();

    // التحقق من الحقول المطلوبة
    if (!body.subject || !body.content) {
      return NextResponse.json(
        { error: 'الموضوع والمحتوى مطلوبان' },
        { status: 400 }
      );
    }

    const isDirector = user.role === 'director';
    let recipientId: string | null = body.recipientId || null;
    let recipientName: string | null = null;

    if (recipientId) {
      // إرسال لمستخدم محدد - نجلب اسمه
      const recipient = await db.user.findUnique({
        where: { id: recipientId },
        select: { id: true, name: true, role: true },
      });

      if (!recipient) {
        return NextResponse.json(
          { error: 'المستلم غير موجود' },
          { status: 404 }
        );
      }

      recipientName = recipient.name;
    } else if (isDirector) {
      // المدير يرسل للجميع - recipientId يبقى null
      recipientName = 'جميع الموظفين';
    } else {
      // الموظف بدون مستلم محدد - نوجهه للمدير افتراضياً
      const director = await db.user.findFirst({
        where: { role: 'director' },
        select: { id: true, name: true },
      });
      if (director) {
        recipientId = director.id;
        recipientName = director.name;
      }
    }

    // التحقق من صحة الأولوية
    const validPriorities = ['low', 'normal', 'high', 'urgent'];
    const priority = validPriorities.includes(body.priority)
      ? body.priority
      : 'normal';

    const message = await db.message.create({
      data: {
        senderId: user.id,
        senderName: user.name,
        senderRole: user.role,
        recipientId,
        recipientName,
        subject: body.subject.trim(),
        content: body.content.trim(),
        priority,
      },
    });

    // إنشاء إشعار للمستلم
    if (recipientId) {
      // إشعار خاص بالمستلم المحدد
      await db.notification.create({
        data: {
          type: 'new_message',
          title: 'رسالة جديدة',
          message: `${user.name}: ${body.subject}`,
          severity: priority === 'urgent' || priority === 'high' ? 'warning' : 'info',
          link: 'messages',
          relatedId: message.id,
          targetRole: 'all', // سيُرشح لاحقاً حسب recipientId في الإشعارات الفردية
        },
      });
    } else {
      // رسالة عامة من المدير - إشعار للجميع
      await db.notification.create({
        data: {
          type: 'new_message',
          title: 'رسالة من المدير',
          message: `${body.subject}`,
          severity: priority === 'urgent' || priority === 'high' ? 'warning' : 'info',
          link: 'messages',
          relatedId: message.id,
          targetRole: 'all',
        },
      });
    }

    return NextResponse.json({ message }, { status: 201 });
  } catch (error: any) {
    if (error.message === 'UNAUTHORIZED') {
      return NextResponse.json({ error: 'غير مصرح' }, { status: 401 });
    }
    console.error('POST /api/messages error:', error);
    return NextResponse.json({ error: 'حدث خطأ أثناء الإرسال' }, { status: 500 });
  }
}
