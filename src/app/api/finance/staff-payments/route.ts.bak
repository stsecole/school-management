import { NextRequest, NextResponse } from 'next/server';
import { db } from '@/lib/db';
import { requireAuth } from '@/lib/auth';
import { getBranchIdForNewRecord, getBranchFilter } from '@/lib/branch-filter';

export const runtime = 'nodejs';
export const dynamic = 'force-dynamic';

// GET /api/finance/staff-payments?month=2024-01&userId=xxx
export async function GET(request: NextRequest) {
  try {
    const user = await requireAuth();
    const isDirector = user.role === 'director';
    if (!isDirector) {
      return NextResponse.json({ error: 'صلاحيات مدير مطلوبة' }, { status: 403 });
    }
    const { searchParams } = new URL(request.url);
    const month = searchParams.get('month');
    const userId = searchParams.get('userId');
    const branchFilter = await getBranchFilter();

    const where: any = { ...branchFilter };
    if (month) where.month = month;
    if (userId && userId !== 'all') where.userId = userId;

    const payments = await db.staffPayment.findMany({
      where,
      orderBy: { paymentDate: 'desc' },
      take: 500,
    });

    return NextResponse.json({ payments });
  } catch (error: any) {
    if (error.message === 'UNAUTHORIZED') return NextResponse.json({ error: 'غير مصرح' }, { status: 401 });
    console.error('GET /api/finance/staff-payments error:', error);
    return NextResponse.json({ error: 'حدث خطأ' }, { status: 500 });
  }
}

// POST /api/finance/staff-payments
export async function POST(request: NextRequest) {
  try {
    const user = await requireAuth();
    const isDirector = user.role === 'director';
    if (!isDirector) {
      return NextResponse.json({ error: 'صلاحيات مدير مطلوبة' }, { status: 403 });
    }
    const body = await request.json();
    const branchId = await getBranchIdForNewRecord();

    if (!body.userId || !body.amount || !body.paymentDate) {
      return NextResponse.json({ error: 'الموظف والمبلغ وتاريخ الدفع مطلوبون' }, { status: 400 });
    }

    // Get user name
    const staffUser = await db.user.findUnique({
      where: { id: body.userId },
      select: { name: true },
    });
    if (!staffUser) {
      return NextResponse.json({ error: 'الموظف غير موجود' }, { status: 404 });
    }

    // Generate receipt number
    const count = await db.staffPayment.count();
    const receiptNumber = `SP-${new Date().getFullYear()}-${String(count + 1).padStart(4, '0')}`;

    const payment = await db.staffPayment.create({
      data: {
        receiptNumber,
        userId: body.userId,
        userName: staffUser.name,
        amount: parseFloat(body.amount),
        month: body.month || `${new Date().getFullYear()}-${String(new Date().getMonth() + 1).padStart(2, '0')}`,
        paymentDate: new Date(body.paymentDate),
        paymentType: body.paymentType || 'salary',
        paymentLabel: body.paymentLabel || null,
        notes: body.notes || null,
        branchId,
      },
    });

    return NextResponse.json({ payment });
  } catch (error: any) {
    if (error.message === 'UNAUTHORIZED') return NextResponse.json({ error: 'غير مصرح' }, { status: 401 });
    console.error('POST /api/finance/staff-payments error:', error);
    return NextResponse.json({ error: 'حدث خطأ: ' + (error.message || '') }, { status: 500 });
  }
}
